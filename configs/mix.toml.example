# iedb/configs/mix.toml.example
# Minimal config for running iedb in mix mode (agent + server in one process):
#   iedb --mode mix --config configs/mix.toml.example
#
# 端口约定（mix 模式）：agent 的本地 HTTP API 绑定 [server].port + 1
# （POST /write, GET /query, GET /health），server 的 API 绑定
# [server].port。agent 通过 [agent].server_url 向 server 上报快照。

[server]
host = "0.0.0.0"
port = 8080

[data]
dir = "/var/lib/iedb-agent"

[wal]
flush_interval_secs = 1
max_write_buffer_ops = 100000

[flush]
snapshot_interval = "10m"
backend = "http"
memory_limit = "512MB"

[agent]
id = "agent-01"
server_url = "http://127.0.0.1:8080"

[query]
data_dir = "/var/lib/iedb-server/data"
query_timeout_secs = 30
max_rows = 10000
max_concurrent_queries = 4

[compaction]
enabled = true
schedule = "0 */6 * * *"
min_file_size_mb = 10
target_file_size_mb = 128
max_concurrent = 2

[agents]
heartbeat_timeout_secs = 30
offline_cleanup_days = 7

[metadata]
db_path = "/var/lib/iedb-server/iedb.db"
